# Docker Compose / production deploy — copy to .env.deploy
# Frontend must call the PUBLIC URL of your backend API

FRONTEND_PORT=3000
BACKEND_PORT=5000

# Browser-facing API base (apicall gateway)
NEXT_PUBLIC_API_URL=https://new-saf-foundation-backend.onrender.com/api

# Comma-separated allowed frontend origins for CORS (also set in backend/.env)
CORS_ORIGIN=https://admin.yourdomain.com

# Public keys (embedded in frontend build)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_FIRECONNECT_CLIENT_KEY=
NEXT_PUBLIC_FIRECONNECT_CLIENT_SECRET=

# Server-only secrets (Next.js API routes at runtime)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
