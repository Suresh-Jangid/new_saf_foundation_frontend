# ========================================================
# SAF FOUNDATION - FRONTEND ENVIRONMENT TEMPLATE
# Copy to .env.local for local development or set in Vercel
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND PUBLIC VARIABLES (Baked into client bundle)
# --------------------------------------------------------
# Backend API Base (apicall gateway)
NEXT_PUBLIC_API_URL=https://new-saf-foundation-backend.onrender.com/api

# Razorpay Key ID (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public storage CDN URL (optional - if using CDN for S3)
NEXT_PUBLIC_STORAGE_URL=

# --------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (Next.js API Routes at runtime)
# DO NOT prefix these with NEXT_PUBLIC_
# --------------------------------------------------------
# Razorpay Server Verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Messaging Gateway (GreenAPI / Meta)
WHATSAPP_API_URL=https://7107.api.greenapi.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Fireconnect SMS / WhatsApp Gateway
FIRECONNECT_CLIENT_KEY=
FIRECONNECT_CLIENT_SECRET=

# --------------------------------------------------------
# 3. PERSISTENT MEDIA STORAGE (IMAGEKIT - PRIMARY CDN & STORAGE)
# Server-side environment variables configured in Vercel / Render
# --------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/safmedia

# Optional S3-Compatible Fallback (AWS S3 / Cloudflare R2 / Supabase)
STORAGE_PROVIDER=imagekit
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --------------------------------------------------------
# 4. COMPILER / OPTIMIZATION
# --------------------------------------------------------
REMOVE_CONSOLE_LOGS=true
ALLOWED_IMAGE_DOMAINS=