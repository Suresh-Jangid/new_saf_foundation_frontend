# Frontend environment — copy to .env.local for local dev or set in hosting dashboard

# Backend API (required)
NEXT_PUBLIC_API_URL=https://new-saf-foundation-backend.onrender.com/api

# Razorpay (public key only — secret stays server-side)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Fireconnect WhatsApp/SMS (public keys)
NEXT_PUBLIC_FIRECONNECT_CLIENT_KEY=
NEXT_PUBLIC_FIRECONNECT_CLIENT_SECRET=

# Server-side only (Next.js /api routes — do NOT prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

REMOVE_CONSOLE_LOGS=true
