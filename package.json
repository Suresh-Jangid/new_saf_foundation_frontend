{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "NODE_ENV=production next build",
    "build:clean": "npm run remove-console && npm run build",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "remove-console": "node scripts/remove-console-logs.js",
    "analyze-bundle": "node scripts/analyze-bundle.js",
    "perf:build": "npm run build && npm run analyze-bundle",
    "perf:dev": "npm run dev -- --turbo",
    "api:audit": "node scripts/api-audit.mjs",
    "api:audit:full": "node scripts/api-audit.mjs --save-responses",
    "ui:screenshots": "node scripts/ui-screenshots.mjs",
    "seed:ui-data": "node scripts/seed-ui-data.mjs",
    "docker:up": "docker compose --env-file .env.deploy up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
