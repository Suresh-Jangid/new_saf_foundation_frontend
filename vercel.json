{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "bom1"
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://new-saf-foundation-backend.onrender.com/api"
  },
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}